	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.token && body.token.accessToken) {",
									"    pm.collectionVariables.set('accessToken', body.token.accessToken);",
									"    pm.collectionVariables.set('refreshToken', body.token.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"login\": \"john.smith\",\n  \"password\": \"StrongPass@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticate with login/password and receive an access/refresh token pair plus the authenticated user's data. Automatically stores accessToken/refreshToken as collection variables for use by other requests."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.accessToken) {",
									"    pm.collectionVariables.set('accessToken', body.accessToken);",
									"    pm.collectionVariables.set('refreshToken', body.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"refresh-token"
							]
						},
						"description": "Issue a new access/refresh token pair from a valid refresh token. Automatically updates the stored collection variables."
					},
					"response": []
				}
			]
		},
